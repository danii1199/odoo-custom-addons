<?xml version="1.0" encoding="utf-8"?>
<!-- Acceso al módulo: solo quien esté en «Solicitudes IG / Usuario» ve el menú, la web /solicitudes-ig y sus datos.
     Al instalar, solo Dani (base.user_admin). -->
<odoo>
    <record id="module_category_solicitudes_ig" model="ir.module.category">
        <field name="name">Solicitudes IG</field>
        <field name="sequence">65</field>
    </record>

    <record id="privilege_solicitudes_ig" model="res.groups.privilege">
        <field name="name">Solicitudes IG</field>
        <field name="description">Acceso a la lista de solicitudes pendientes de Instagram y a la web /solicitudes-ig.</field>
        <field name="category_id" ref="module_category_solicitudes_ig"/>
    </record>

    <record id="group_ig_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_solicitudes_ig"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
