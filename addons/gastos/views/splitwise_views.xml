<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_importar_splitwise_form" model="ir.ui.view">
        <field name="name">gastos.importar.splitwise.form</field>
        <field name="model">gastos.importar.splitwise</field>
        <field name="arch" type="xml">
            <form>
                <field name="paso" invisible="1"/>
                <field name="grupo_id" invisible="1"/>
                <div class="text-muted mb-2" invisible="paso != 'subir'">
                    En Splitwise, entra en el grupo y usa «Exportar como hoja de cálculo». Lo que ya se importó antes no se repite.
                </div>
                <group invisible="paso != 'subir'">
                    <field name="archivo" filename="nombre_archivo"/>
                    <field name="nombre_archivo" invisible="1"/>
                </group>
                <div invisible="paso != 'revisar'">
                    <field name="resumen" nolabel="1"/>
                    <p class="text-muted mt-2">Empareja cada persona de Splitwise con un miembro del grupo; si lo dejas vacío,
                        se crea uno nuevo con ese nombre. No se avisa por correo de cada movimiento importado.</p>
                    <field name="linea_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="grupo_id" column_invisible="1"/>
                            <field name="nombre"/>
                            <field name="miembro_id" placeholder="Crear miembro nuevo"/>
                        </list>
                    </field>
                </div>
                <footer>
                    <button name="action_analizar" type="object" string="Revisar" class="btn-primary" invisible="paso != 'subir'"/>
                    <button name="action_importar" type="object" string="Importar" class="btn-primary" invisible="paso != 'revisar'"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
