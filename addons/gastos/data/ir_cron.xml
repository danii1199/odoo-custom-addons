<?xml version="1.0" encoding="utf-8"?>
<!-- Resumen semanal: cada lunes a las 9:00 (hora del contenedor, Europe/Madrid), un correo a cada miembro con saldo
     pendiente en los grupos que tengan «Resumen semanal» activado. -->
<odoo noupdate="1">
    <record id="cron_resumen_semanal" model="ir.cron">
        <field name="name">Gastos compartidos: resumen semanal</field>
        <field name="model_id" ref="model_gastos_grupo"/>
        <field name="state">code</field>
        <field name="code">model._cron_resumen_semanal()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(weekday=0, days=1)).strftime('%Y-%m-%d 08:00:00')"/>
    </record>
</odoo>
