<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hero_kanban" model="ir.ui.view">
        <field name="name">ow.hero.kanban</field>
        <field name="model">ow.hero</field>
        <field name="arch" type="xml">
            <kanban default_group_by="role" group_create="false" group_delete="false" group_edit="false" records_draggable="false">
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="portrait" widget="image" options="{'img_class': 'object-fit-cover'}" style="width:72px"/>
                        </aside>
                        <main class="ms-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="subrole_name" class="text-muted"/>
                            <div class="small text-muted"><field name="cosmetic_count"/> cosméticos</div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hero_list" model="ir.ui.view">
        <field name="name">ow.hero.list</field>
        <field name="model">ow.hero</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_check_updates" type="object" string="Buscar actualizaciones" class="btn-primary"
                            display="always" groups="overwatch.group_ow_manager"
                            help="Trae de internet los cambios de los héroes (vida, habilidades y sus números) y los pases nuevos."/>
                </header>
                <field name="portrait" widget="image" options="{'size': [32, 32]}" string=""/>
                <field name="name"/>
                <field name="role"/>
                <field name="subrole_name"/>
                <field name="health"/>
                <field name="cosmetic_count"/>
                <field name="key" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hero_form" model="ir.ui.view">
        <field name="name">ow.hero.form</field>
        <field name="model">ow.hero</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_web" type="object" string="Ver en la web" class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <field name="portrait" widget="image" class="oe_avatar" options="{'preview_image': 'portrait'}"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="description" placeholder="Descripción"/>
                    </div>
                    <group>
                        <group>
                            <field name="role"/>
                            <field name="subrole"/>
                            <field name="location"/>
                            <field name="birthday"/>
                            <field name="age"/>
                        </group>
                        <group>
                            <field name="health"/>
                            <field name="armor"/>
                            <field name="shields"/>
                            <field name="key"/>
                            <field name="wiki_name"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Habilidades" name="abilities">
                            <field name="ability_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="kind"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="stats_text" optional="show"/>
                                    <field name="icon_url" optional="hide"/>
                                    <field name="video_url" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Historia" name="story">
                            <group>
                                <field name="story_video_url" widget="url"/>
                                <field name="story_summary"/>
                            </group>
                            <field name="chapter_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="title"/>
                                    <field name="content"/>
                                    <field name="picture_url" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cosméticos" name="cosmetics">
                            <field name="cosmetic_ids">
                                <list editable="bottom">
                                    <field name="type"/>
                                    <field name="name"/>
                                    <field name="rarity"/>
                                    <field name="source"/>
                                    <field name="media_url" widget="url" optional="hide"/>
                                    <field name="image" widget="image" options="{'size': [32, 32]}" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Imágenes" name="images">
                            <group>
                                <field name="portrait_url" widget="url"/>
                                <field name="background_url" widget="url"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hero_search" model="ir.ui.view">
        <field name="name">ow.hero.search</field>
        <field name="model">ow.hero</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="tank" string="Tanques" domain="[('role', '=', 'tank')]"/>
                <filter name="damage" string="Daño" domain="[('role', '=', 'damage')]"/>
                <filter name="support" string="Apoyo" domain="[('role', '=', 'support')]"/>
                <separator/>
                <filter name="archived" string="Archivados" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="by_role" string="Rol" context="{'group_by': 'role'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_heroes" model="ir.actions.act_window">
        <field name="name">Héroes</field>
        <field name="res_model">ow.hero</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay héroes</p>
            <p>Configuración → Actualizar catálogo los trae todos (OverFast API y la wiki de Overwatch).</p>
        </field>
    </record>
</odoo>
