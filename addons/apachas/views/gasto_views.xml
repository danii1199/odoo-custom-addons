<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gasto_list" model="ir.ui.view">
        <field name="name">gastos.gasto.list</field>
        <field name="model">gastos.gasto</field>
        <field name="arch" type="xml">
            <list>
                <field name="fecha"/>
                <field name="grupo_id"/>
                <field name="categoria"/>
                <field name="name"/>
                <field name="pagador_id"/>
                <field name="importe" widget="monetary" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_gasto_form" model="ir.ui.view">
        <field name="name">gastos.gasto.form</field>
        <field name="model">gastos.gasto</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="p. ej. Cena del sábado"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="grupo_id" options="{'no_create': True}"/>
                            <field name="importe" widget="monetary"/>
                            <field name="pagador_id" options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="fecha"/>
                            <field name="categoria"/>
                            <field name="reparto" widget="radio"/>
                        </group>
                    </group>
                    <field name="linea_ids">
                        <list editable="bottom">
                            <field name="grupo_id" column_invisible="1"/>
                            <field name="miembro_id" options="{'no_create': True}"/>
                            <field name="valor" column_invisible="parent.reparto == 'igual'"/>
                            <field name="importe" widget="monetary"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <div class="text-muted small" invisible="reparto == 'igual'">
                        <span invisible="reparto != 'partes'">Valor = partes (2 paga el doble que 1).</span>
                        <span invisible="reparto != 'porcentaje'">Valor = porcentaje; tienen que sumar 100.</span>
                        <span invisible="reparto != 'importes'">Valor = importe exacto; tienen que sumar el total.</span>
                    </div>
                    <group>
                        <field name="nota"/>
                        <field name="ticket" widget="image" options="{'size': [0, 180]}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gasto_search" model="ir.ui.view">
        <field name="name">gastos.gasto.search</field>
        <field name="model">gastos.gasto</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="grupo_id"/>
                <field name="pagador_id"/>
                <filter name="este_mes" string="Este mes" domain="[('fecha', '&gt;=', 'today -1m')]"/>
                <group>
                    <filter name="por_grupo" string="Grupo" context="{'group_by': 'grupo_id'}"/>
                    <filter name="por_categoria" string="Categoría" context="{'group_by': 'categoria'}"/>
                    <filter name="por_mes" string="Mes" context="{'group_by': 'fecha:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_gasto_pivot" model="ir.ui.view">
        <field name="name">gastos.gasto.pivot</field>
        <field name="model">gastos.gasto</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="categoria" type="row"/>
                <field name="fecha" interval="month" type="col"/>
                <field name="importe" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_gastos" model="ir.actions.act_window">
        <field name="name">Gastos</field>
        <field name="res_model">gastos.gasto</field>
        <field name="view_mode">list,form,pivot</field>
    </record>
</odoo>
