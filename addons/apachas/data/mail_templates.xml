<?xml version="1.0" encoding="utf-8"?>
<!-- Cuerpos de los correos (QWeb, se renderizan en GastosGrupo._correo, uno por miembro).
     Valores: grupo, miembro, saldo, debo [(acreedor, importe)], me_deben [(deudor, importe)], fmt(importe), url,
     autor (en gasto/pago) y gasto o pago. Estilos en línea: los clientes de correo ignoran las hojas de estilo. -->
<odoo>
    <template id="correo_marco" name="Apachas: marco del correo">
        <div style="font-family:Arial,Helvetica,sans-serif;max-width:560px;margin:0 auto;color:#222;">
            <div style="background:#1f7a5c;color:#fff;padding:16px 20px;border-radius:10px 10px 0 0;">
                <div style="font-size:13px;opacity:.85;">Apachas</div>
                <div style="font-size:20px;font-weight:bold;"><t t-out="grupo.name"/></div>
            </div>
            <div style="border:1px solid #e3e3e3;border-top:0;padding:20px;border-radius:0 0 10px 10px;">
                <p style="margin-top:0;">Hola, <t t-out="miembro.name"/>:</p>
                <t t-out="0"/>
                <div style="background:#f6f7f8;border-radius:8px;padding:12px 14px;margin:16px 0;">
                    <t t-if="saldo &gt; 0">Tu saldo: <b style="color:#1f7a5c;">te deben <t t-out="fmt(saldo)"/></b></t>
                    <t t-elif="saldo &lt; 0">Tu saldo: <b style="color:#c0392b;">debes <t t-out="fmt(-saldo)"/></b></t>
                    <t t-else="">Estás en paz con el grupo 🎉</t>
                    <ul t-if="debo or me_deben" style="margin:8px 0 0;padding-left:18px;">
                        <li t-foreach="debo" t-as="d">Pagas <b t-out="fmt(d[1])"/> a <t t-out="d[0].name"/></li>
                        <li t-foreach="me_deben" t-as="d"><t t-out="d[0].name"/> te paga <b t-out="fmt(d[1])"/></li>
                    </ul>
                </div>
                <p style="text-align:center;margin:20px 0 4px;">
                    <a t-att-href="url" style="background:#1f7a5c;color:#fff;text-decoration:none;padding:10px 18px;border-radius:6px;display:inline-block;">Ver el grupo</a>
                </p>
            </div>
        </div>
    </template>

    <template id="correo_gasto" name="Apachas: correo de gasto nuevo">
        <t t-call="apachas.correo_marco">
            <p><t t-out="autor.name or gasto.write_uid.name"/> <t t-out="'ha modificado un gasto' if accion == 'editado' else 'ha apuntado un gasto'"/>:</p>
            <table style="width:100%;border-collapse:collapse;">
                <tr><td style="padding:4px 0;color:#666;">Concepto</td><td style="text-align:right;"><b t-out="gasto.name"/></td></tr>
                <tr><td style="padding:4px 0;color:#666;">Importe</td><td style="text-align:right;"><b t-out="fmt(gasto.importe)"/></td></tr>
                <tr><td style="padding:4px 0;color:#666;">Pagado por</td><td style="text-align:right;" t-out="gasto.pagador_id.name"/></tr>
                <tr><td style="padding:4px 0;color:#666;">Fecha</td><td style="text-align:right;" t-out="gasto.fecha.strftime('%d/%m/%Y')"/></tr>
                <t t-set="mia" t-value="gasto.linea_ids.filtered(lambda l: l.miembro_id == miembro)"/>
                <tr><td style="padding:4px 0;color:#666;">Te toca</td><td style="text-align:right;"><b t-out="fmt(mia.importe) if mia else 'nada'"/></td></tr>
            </table>
        </t>
    </template>

    <template id="correo_pago" name="Apachas: correo de pago">
        <t t-call="apachas.correo_marco">
            <t t-if="accion == 'editado'">
                <p><t t-out="pago.write_uid.name"/> ha modificado un pago. Ahora: <b t-out="pago.pagador_id.name"/> ha pagado
                    <b t-out="fmt(pago.importe)"/> a <b t-out="pago.receptor_id.name"/>.</p>
                <p style="color:#666;">Cambios: <t t-out="cambios"/></p>
            </t>
            <p t-else=""><b t-out="pago.pagador_id.name"/> ha pagado <b t-out="fmt(pago.importe)"/> a <b t-out="pago.receptor_id.name"/>
                <t t-if="pago.nota">(<t t-out="pago.nota"/>)</t>.</p>
        </t>
    </template>

    <template id="correo_recordatorio" name="Apachas: recordatorio de pagos">
        <t t-call="apachas.correo_marco">
            <p>Te recordamos que tienes pagos pendientes en este grupo.</p>
        </t>
    </template>

    <template id="correo_resumen" name="Apachas: resumen semanal">
        <t t-call="apachas.correo_marco">
            <p>Así van las cuentas esta semana (gastado en total: <b t-out="fmt(grupo.total_gastado)"/>).</p>
        </t>
    </template>
</odoo>
